# Copy to .env and edit. NEVER commit .env.
AWAAZ_MODE=production

# One key per operator / gateway, "key:operator-id". Generate each with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# The operator id is what appears in the audit log, so use a real accountable name or badge id, one per person.
AWAAZ_API_KEYS=REPLACE_WITH_32+_CHAR_RANDOM_KEY:operator-badge-0001,REPLACE_WITH_ANOTHER_KEY_32+_CHARS:gateway-sbc-01

# Exact origin(s) the operator console is served from (no wildcard).
AWAAZ_ORIGINS=https://awaaz.example.gov.in

# Concurrent live streams one GPU host admits. Measure with server/bench_capacity.py on YOUR hardware; the
# author's RTX 4060 laptop sustained 2.
AWAAZ_MAX_SESSIONS=2

AWAAZ_MAX_UPLOAD_MB=25
AWAAZ_RATE_PER_MIN=30

# Keep the redacted transcript line inside feedback rows? Default 0 = store verdicts and numbers only.
AWAAZ_STORE_TEXT=0

# Operator ids allowed to see the UNREDACTED transcript (comma list). Empty = nobody: everyone gets redacted text and
# the raw text never leaves the server. Grant sparingly (supervisors / investigating officers).
AWAAZ_REVEAL_OPERATORS=
